#!/bin/bash
#
# L-04: Pre-commit hook to scan for potential secrets
# Prevents accidental commit of credentials, API keys, and sensitive data
#
# Install: npm run setup:hooks (or copy to .git/hooks/pre-commit)
#

# Color codes for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "Scanning for potential secrets..."

# Get list of staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No files to scan.${NC}"
    exit 0
fi

# Patterns to detect potential secrets
# Each pattern: "pattern|description"
SECRET_PATTERNS=(
    'password\s*=\s*["\047][^"\047]+["\047]|Hardcoded password'
    'api[_-]?key\s*=\s*["\047][^"\047]+["\047]|API key assignment'
    'secret[_-]?key\s*=\s*["\047][^"\047]+["\047]|Secret key assignment'
    'private[_-]?key\s*=\s*["\047][^"\047]+["\047]|Private key assignment'
    'aws[_-]?access[_-]?key[_-]?id\s*=|AWS Access Key'
    'aws[_-]?secret[_-]?access[_-]?key\s*=|AWS Secret Key'
    'mongodb(\+srv)?://[^/\s]+:[^@\s]+@|MongoDB URI with credentials'
    'postgres://[^/\s]+:[^@\s]+@|PostgreSQL URI with credentials'
    'mysql://[^/\s]+:[^@\s]+@|MySQL URI with credentials'
    'PRIVATE KEY-----|Private key block'
    'sk-[a-zA-Z0-9]{48}|OpenAI API key'
    'ghp_[a-zA-Z0-9]{36}|GitHub personal access token'
    'gho_[a-zA-Z0-9]{36}|GitHub OAuth token'
    'xox[baprs]-[a-zA-Z0-9-]+|Slack token'
)

# Files/patterns to exclude from scanning
EXCLUDE_PATTERNS=(
    '\.lock$'
    '\.min\.js$'
    '\.min\.css$'
    'node_modules/'
    '\.git/'
    '\.env\.example$'
    '\.env\.template$'
    'package-lock\.json$'
    'scripts/hooks/'
)

FOUND_SECRETS=0
WARNINGS=()

for FILE in $STAGED_FILES; do
    # Skip excluded files
    SKIP=0
    for EXCLUDE in "${EXCLUDE_PATTERNS[@]}"; do
        if echo "$FILE" | grep -qE "$EXCLUDE"; then
            SKIP=1
            break
        fi
    done

    if [ $SKIP -eq 1 ]; then
        continue
    fi

    # Skip binary files
    if file "$FILE" 2>/dev/null | grep -q "binary"; then
        continue
    fi

    # Check each pattern
    for PATTERN_DESC in "${SECRET_PATTERNS[@]}"; do
        PATTERN=$(echo "$PATTERN_DESC" | cut -d'|' -f1)
        DESC=$(echo "$PATTERN_DESC" | cut -d'|' -f2)

        # Search for pattern in staged content
        MATCHES=$(git diff --cached -U0 "$FILE" 2>/dev/null | grep -iE "^\+.*$PATTERN" | head -3)

        if [ -n "$MATCHES" ]; then
            FOUND_SECRETS=1
            WARNINGS+=("${RED}[BLOCKED]${NC} $DESC in ${YELLOW}$FILE${NC}")
            echo -e "${RED}[BLOCKED]${NC} Potential $DESC found in ${YELLOW}$FILE${NC}"
            echo "$MATCHES" | sed 's/^/  /'
            echo ""
        fi
    done
done

# Check for .env files being committed (should never happen)
for FILE in $STAGED_FILES; do
    if echo "$FILE" | grep -qE '^\.env$|^\.env\.[^.]+$' && ! echo "$FILE" | grep -qE '\.example$|\.template$'; then
        FOUND_SECRETS=1
        echo -e "${RED}[BLOCKED]${NC} Environment file ${YELLOW}$FILE${NC} should not be committed!"
        echo "  Add it to .gitignore instead."
        echo ""
    fi
done

if [ $FOUND_SECRETS -eq 1 ]; then
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}COMMIT BLOCKED: Potential secrets found!${NC}"
    echo -e "${RED}========================================${NC}"
    echo ""
    echo "Please remove sensitive data before committing."
    echo "If this is a false positive, you can bypass with:"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}No secrets detected. Proceeding with commit.${NC}"
exit 0
