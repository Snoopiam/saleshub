{
  "name": "saleshub",
  "version": "2.0.0",
  "description": "Professional real estate sales offer document generator for UAE properties",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node --max-old-space-size=4096 server.js",
    "build:css": "tailwindcss -i ./css/tailwind-source.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind-source.css -o ./css/tailwind.css --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint js/ backend/src/"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "mongodb": "^6.21.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.14.0",
    "puppeteer": "^24.34.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "jsdom": "^27.4.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vitest": "^1.2.0"
  }
}
